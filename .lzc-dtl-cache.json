{
  "name": "Flare",
  "package": "cloud.lazycat.app.flare",
  "description": "一个现代的自托管文件共享平台",
  "homepage": "https://github.com/FlintSH/Flare",
  "author": "FlintSH",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "flare",
  "version": "1.2.0",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "app_3000_3000": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    },
    "postgres_5432_5432": {
      "use": false
    }
  },
  "image_flintsh_flare_latest": {
    "originalImage": "flintsh/flare:latest",
    "pushTarget": "lazycat",
    "newImageName": "registry.lazycat.cloud/czyt/flintsh/flare:1d7b01e583feb495",
    "timestamp": "2025-03-06T13:55:06.574Z"
  },
  "app_volume_uploads_/app/uploads_action": "emptyDir",
  "app_volume_/app/uploads_location": "app_data",
  "image_postgres_16-alpine": {
    "originalImage": "postgres:16-alpine",
    "pushTarget": "lazycat",
    "newImageName": "registry.lazycat.cloud/czyt/library/postgres:b0193ab17e40d829",
    "timestamp": "2025-03-06T13:55:40.861Z"
  },
  "postgres_volume_postgres_data_/var/lib/postgresql/data_action": "emptyDir",
  "postgres_volume_/var/lib/postgresql/data_location": "app_data"
}
